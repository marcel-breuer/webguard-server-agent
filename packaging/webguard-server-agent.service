[Unit]
Description=WebGuard Server Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webguard-server-agent
Group=webguard-server-agent
ExecStart=/usr/local/bin/webguard-server-agent --config /etc/webguard-server-agent/config.json
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/webguard-server-agent
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
